erDiagram
    USUARIO {
        int id_usuario PK
        string email UK
        string password_hash
        string nombre
        string apellidos
        string telefono
        string rol "cliente | administradora"
        string token_sesion "recordar sesion"
        boolean activo
        timestamp fecha_registro
    }
    DIRECCION {
        int id_direccion PK
        int id_usuario FK
        string alias
        string nombre_destinatario
        string telefono
        string calle
        string codigo_postal
        string ciudad
        string provincia
        string pais
        boolean es_predeterminada
    }
    CATEGORIA {
        int id_categoria PK
        string nombre UK
        string slug UK
        string descripcion
        boolean activa
    }
    PRODUCTO {
        int id_producto PK
        int id_categoria FK
        string sku UK
        string nombre
        string slug UK
        text descripcion
        decimal precio_base
        decimal porcentaje_iva
        decimal precio_con_iva
        string imagen_url
        boolean activo
        timestamp fecha_creacion
    }
    TALLA {
        int id_talla PK
        string codigo UK "XS | S | M | L | XL"
        int orden
    }
    PRODUCTO_TALLA {
        int id_producto_talla PK
        int id_producto FK
        int id_talla FK
        string sku_variante UK
        int stock_disponible
        int stock_reservado
    }
    GUIA_TALLA {
        int id_guia_talla PK
        int id_talla FK
        int id_categoria FK "nullable"
        decimal pecho_cm
        decimal cintura_cm
        decimal cadera_cm
    }
    CUPON {
        int id_cupon PK
        string codigo UK
        string tipo_descuento "porcentaje | fijo"
        decimal valor_descuento
        decimal importe_minimo
        timestamp fecha_inicio
        timestamp fecha_fin
        int usos_maximos
        int usos_actuales
        boolean activo
    }
    CARRITO {
        int id_carrito PK
        int id_usuario FK "nullable"
        int id_cupon FK "nullable"
        string token_sesion UK
        decimal gastos_envio_estimados
        timestamp fecha_actualizacion
    }
    LINEA_CARRITO {
        int id_linea_carrito PK
        int id_carrito FK
        int id_producto_talla FK
        int cantidad
        decimal precio_unitario
    }
    PEDIDO {
        int id_pedido PK
        string numero_pedido UK
        int id_usuario FK "nullable para invitado"
        int id_direccion FK "nullable"
        int id_cupon FK "nullable"
        string email_cliente
        string nombre_destinatario
        string telefono_contacto
        string direccion_entrega
        string codigo_postal
        string ciudad
        string provincia
        string estado_pedido "Pendiente | Enviado"
        decimal subtotal
        decimal gastos_envio
        decimal descuento_aplicado
        decimal total
        timestamp fecha_pedido
        timestamp fecha_envio
    }
    LINEA_PEDIDO {
        int id_linea_pedido PK
        int id_pedido FK
        int id_producto_talla FK
        string nombre_producto
        string talla_producto
        int cantidad
        decimal precio_unitario_iva
        decimal subtotal_linea
    }
    PAGO {
        int id_pago PK
        int id_pedido FK
        string metodo_pago "Tarjeta | Bizum"
        string estado_pago "Pendiente | Autorizado | Completado | Fallido | Reembolsado"
        decimal importe
        string referencia_pasarela UK
        boolean soporte_3ds
        string estado_3ds
        string ultimos_digitos_tarjeta "nullable"
        string telefono_bizum "nullable"
        timestamp fecha_pago
    }
    USUARIO ||--o{ DIRECCION : "guarda"
    USUARIO |o--o{ CARRITO : "mantiene"
    USUARIO |o--o{ PEDIDO : "realiza"
    DIRECCION |o--o{ PEDIDO : "recibe"
    CATEGORIA ||--o{ PRODUCTO : "clasifica"
    CATEGORIA |o--o{ GUIA_TALLA : "agrupa"
    PRODUCTO ||--|{ PRODUCTO_TALLA : "dispone"
    TALLA ||--o{ PRODUCTO_TALLA : "asigna"
    TALLA ||--o{ GUIA_TALLA : "define"
    CUPON |o--o{ CARRITO : "descuenta"
    CUPON |o--o{ PEDIDO : "aplica"
    CARRITO ||--o{ LINEA_CARRITO : "contiene"
    LINEA_CARRITO }o--|| PRODUCTO_TALLA : "referencia"
    PEDIDO ||--|{ LINEA_PEDIDO : "detalla"
    LINEA_PEDIDO }o--|| PRODUCTO_TALLA : "referencia"
    PEDIDO ||--o{ PAGO : "genera"
