%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    participant PB as Pasarela Bizum
    participant BK as App del banco
    U->>FE: pagarConBizum(telefono)
    FE->>FE: validarFormatoTelefono(telefono)
    FE->>BE: crearPedido(contacto, direccionEnvio, telefono) : POST /api/pedidos
    BE->>BE: ProductoTalla.reservarStock(cantidad)
    BE->>DB: savePedido(PENDIENTE)
    DB-->>BE: Pedido (idPedido, numeroPedido)
    BE->>BE: PagoBizum.procesarPago(pasarela)
    BE->>PB: PasarelaPago.iniciarPago(importe, numeroPedido)
    PB->>BK: PasarelaBizum.solicitarAutorizacionMovil(telefono, importe)
    BK->>U: notificarSolicitudPago(importe)
    U->>BK: responderSolicitud(idOperacion, autorizada)
    BK-->>PB: resultadoAutorizacion
    PB-->>BE: referenciaPasarela
    BE->>PB: PasarelaPago.verificarEstado(referenciaPasarela)
    alt verificarEstado() == COMPLETADO
        PB-->>BE: COMPLETADO
        BE->>BE: Pedido.confirmarPago(pago, correo)
        BE->>BE: ProductoTalla.descontarStock(cantidad)
        BE->>BE: Carrito.vaciar()
        BE->>DB: savePago(COMPLETADO)
        DB-->>BE: OK
        BE-->>FE: 200 OK : numeroPedido
        FE-->>U: mostrarConfirmacion(numeroPedido)
    else verificarEstado() == FALLIDO or timeout
        PB-->>BE: FALLIDO
        BE->>BE: Pago.marcarFallido()
        BE->>BE: ProductoTalla.liberarReserva(cantidad)
        BE->>DB: savePago(FALLIDO)
        DB-->>BE: OK
        BE-->>FE: 402 Payment Required
        FE-->>U: mostrarErrorPago()
    end
