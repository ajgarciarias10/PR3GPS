%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    participant PB as Pasarela Bizum
    participant BK as App del banco
    U->>FE: Elige Bizum e introduce su teléfono
    FE->>FE: validarFormatoTelefono(telefono)
    FE->>BE: POST /api/pedidos (contacto, direccionEnvio, telefono)
    BE->>DB: StockTalla.reservar(cantidad) y savePedido(PENDIENTE)
    DB-->>BE: Pedido (idPedido, numeroPedido)
    BE->>PB: PasarelaPago.cobrar(PagoBizum)
    PB->>BK: PagoBizum.solicitarAutorizacion()
    BK-->>U: Notifica solicitud de pago en la app del banco
    U->>BK: Autoriza o rechaza la operación
    BK-->>PB: Resultado de autorización
    alt Pago autorizado
        PB-->>BE: true (referencia, estado APROBADO)
        BE->>DB: savePago(APROBADO), descontarStock() y vaciarCarrito()
        DB-->>BE: OK
        BE-->>FE: 200 OK (Pedido confirmado, numeroPedido)
        FE-->>U: Muestra pantalla de confirmación
    else Denegado o expirado
        PB-->>BE: false (estado RECHAZADO)
        BE->>DB: savePago(RECHAZADO) y liberarReservaStock()
        DB-->>BE: OK
        BE-->>FE: 402 Payment Required
        FE-->>U: Muestra error y permite reintentar
    end
