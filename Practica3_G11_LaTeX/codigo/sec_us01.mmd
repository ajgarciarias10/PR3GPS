%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    U->>FE: abrirCatalogo()
    FE->>BE: listarProductos() : GET /api/productos
    BE->>DB: findAllProductosConStock()
    DB-->>BE: Producto[] con StockTalla[]
    loop for producto in productos
        BE->>BE: Producto.estaDisponible()
        BE->>BE: Producto.tallasDisponibles()
    end
    BE-->>FE: 200 OK : Producto[]
    alt productos.size() > 0
        FE-->>U: mostrarTarjetas(productos)
    else productos.size() == 0
        FE-->>U: mostrarCatalogoVacio()
    end
