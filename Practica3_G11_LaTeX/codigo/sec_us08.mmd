%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    U->>FE: enviarRegistro(nombre, email, password)
    FE->>FE: validarPasswordSegura(password)
    FE->>BE: registrar(nombre, email, password) : POST /api/auth/registro
    BE->>DB: existsUsuarioByEmail(email)
    DB-->>BE: boolean existe
    alt existsUsuarioByEmail(email) == false
        BE->>BE: hashPassword(password)
        BE->>BE: Cliente.registrarse(nombre, email, passwordHash)
        BE->>DB: saveCliente(cliente)
        DB-->>BE: idUsuario
        BE-->>FE: 201 Created : Cliente
        FE-->>U: mostrarRegistroCompletado()
    else existsUsuarioByEmail(email) == true
        BE-->>FE: 409 Conflict
        FE-->>U: mostrarErrorEmailEnUso()
    end
    U->>FE: enviarLogin(email, password, recordarSesion)
    FE->>BE: login(email, password, recordarSesion) : POST /api/auth/login
    BE->>DB: findUsuarioByEmail(email)
    DB-->>BE: Cliente (passwordHash)
    BE->>BE: Usuario.iniciarSesion(email, password)
    alt iniciarSesion() == true
        BE-->>FE: 200 OK : tokenSesion
        FE->>BE: obtenerHistorial() : GET /api/cuenta/pedidos
        BE->>BE: Cliente.consultarHistorial()
        BE->>DB: findPedidosByCliente(idUsuario)
        DB-->>BE: Pedido[]
        BE-->>FE: 200 OK : Pedido[]
        FE-->>U: mostrarHistorial(pedidos)
    else iniciarSesion() == false
        BE-->>FE: 401 Unauthorized
        FE-->>U: mostrarErrorAcceso()
    end
    opt anadirDireccion(direccion)
        U->>FE: anadirDireccion(direccion)
        FE->>BE: guardarDireccion(direccion) : POST /api/cuenta/direcciones
        BE->>BE: Cliente.guardarDireccion(Direccion)
        BE->>DB: saveDireccion(direccion)
        DB-->>BE: OK
        BE-->>FE: 201 Created : Direccion
        FE-->>U: mostrarDireccion(direccion)
    end
