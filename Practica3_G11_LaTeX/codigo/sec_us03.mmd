%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    U->>FE: abrirCesta()
    FE->>BE: obtenerCarrito() : GET /api/carrito
    BE->>DB: findCarritoConLineas(idCarrito)
    DB-->>BE: Carrito con LineaCarrito[]
    BE->>BE: Carrito.calcularSubtotal()
    BE->>BE: Carrito.calcularGastosEnvio()
    BE->>BE: Carrito.calcularTotal()
    BE-->>FE: 200 OK : Carrito con desglose
    FE-->>U: mostrarCesta(carrito)
    opt cambiarCantidad(idLinea, cantidad)
        U->>FE: cambiarCantidad(idLinea, cantidad)
        FE->>BE: modificarLinea(idLinea, cantidad) : PATCH /api/carrito/lineas/idLinea
        BE->>DB: findStockByLinea(idLinea)
        DB-->>BE: ProductoTalla
        BE->>BE: ProductoTalla.tieneStock(cantidad)
        alt tieneStock(cantidad) == true
            BE->>BE: Carrito.modificarCantidad(idLinea, cantidad)
            BE->>BE: LineaCarrito.calcularSubtotalLinea()
            BE->>BE: Carrito.calcularTotal()
            BE->>DB: saveCarrito(carrito)
            DB-->>BE: OK
            BE-->>FE: 200 OK : Carrito
            FE-->>U: actualizarImportes(carrito)
        else tieneStock(cantidad) == false
            BE-->>FE: 409 Conflict
            FE-->>U: mostrarAvisoStock(unidadesMax)
        end
    end
    opt eliminarArticulo(idLinea)
        U->>FE: eliminarArticulo(idLinea)
        FE->>BE: eliminarLinea(idLinea) : DELETE /api/carrito/lineas/idLinea
        BE->>BE: Carrito.eliminarLinea(idLinea)
        BE->>BE: Carrito.calcularSubtotal()
        BE->>BE: Carrito.calcularGastosEnvio()
        BE->>BE: Carrito.calcularTotal()
        BE->>DB: deleteLineaCarrito(idLinea)
        DB-->>BE: OK
        BE-->>FE: 200 OK : Carrito
        FE-->>U: actualizarCesta(carrito)
    end
