%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    participant PG as Pasarela de pago
    participant CO as Servicio de correo
    U->>FE: pagar(datosEnvio, datosTarjeta)
    FE->>FE: validarCamposTarjeta()
    FE->>BE: crearPedido(contacto, direccionEnvio, datosTarjeta) : POST /api/pedidos
    BE->>BE: StockTalla.reservar(cantidad)
    BE->>DB: savePedido(PENDIENTE)
    DB-->>BE: Pedido (idPedido, numeroPedido)
    BE->>PG: PasarelaPago.cobrar(PagoTarjeta)
    PG->>U: PagoTarjeta.autenticar3DS()
    U-->>PG: codigoConfirmacion3DS
    alt Pago aprobado
        PG-->>BE: true : referencia
        BE->>DB: savePago(APROBADO)
        BE->>DB: descontarStock()
        BE->>DB: vaciarCarrito()
        DB-->>BE: OK
        BE->>CO: ServicioCorreo.enviarConfirmacion(Pedido)
        CO-->>BE: OK
        BE-->>FE: 200 OK : numeroPedido
        FE-->>U: mostrarConfirmacion(numeroPedido)
    else Pago rechazado
        PG-->>BE: false
        BE->>DB: savePago(RECHAZADO)
        BE->>DB: liberarReservaStock()
        DB-->>BE: OK
        BE-->>FE: 402 Payment Required
        FE-->>U: mostrarErrorPago()
    end
