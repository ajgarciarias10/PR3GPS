%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    participant PG as Pasarela de pago
    participant CO as Servicio de correo
    U->>FE: pagar(datosEnvio, datosTarjeta)
    FE->>FE: validarCamposTarjeta()
    FE->>BE: crearPedido(contacto, direccionEnvio, datosTarjeta) : POST /api/pedidos
    BE->>BE: ProductoTalla.reservarStock(cantidad)
    BE->>DB: savePedido(PENDIENTE)
    DB-->>BE: Pedido (idPedido, numeroPedido)
    BE->>BE: PagoTarjeta.procesarPago(pasarela)
    BE->>PG: PasarelaPago.iniciarPago(importe, numeroPedido)
    PG->>U: PagoTarjeta.autenticar3DS(token3ds)
    U->>PG: confirmar3DS(codigoOTP)
    PG-->>BE: referenciaPasarela
    BE->>PG: PasarelaPago.verificarEstado(referenciaPasarela)
    alt verificarEstado() == COMPLETADO
        PG-->>BE: COMPLETADO
        BE->>BE: Pedido.confirmarPago(pago, correo)
        BE->>BE: ProductoTalla.descontarStock(cantidad)
        BE->>BE: Carrito.vaciar()
        BE->>DB: savePago(COMPLETADO)
        DB-->>BE: OK
        BE->>CO: ServicioCorreo.enviarConfirmacionPedido(email, pedido)
        CO-->>BE: OK
        BE-->>FE: 200 OK : numeroPedido
        FE-->>U: mostrarConfirmacion(numeroPedido)
    else verificarEstado() == FALLIDO
        PG-->>BE: FALLIDO
        BE->>BE: Pago.marcarFallido()
        BE->>BE: ProductoTalla.liberarReserva(cantidad)
        BE->>DB: savePago(FALLIDO)
        DB-->>BE: OK
        BE-->>FE: 402 Payment Required
        FE-->>U: mostrarErrorPago()
    end
