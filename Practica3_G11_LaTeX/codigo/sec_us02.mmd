    FE->>BE: agregarLinea(idProducto, talla, cantidad) : POST /api/carrito/lineas
    BE->>DB: findStockByTalla(idProducto, talla)
    DB-->>BE: StockTalla
    BE->>BE: StockTalla.hayStock(cantidad)
    alt hayStock(cantidad) == true
        BE->>BE: Carrito.agregarProducto(p, talla, cantidad)
        BE->>BE: LineaCarrito.calcularImporte()
