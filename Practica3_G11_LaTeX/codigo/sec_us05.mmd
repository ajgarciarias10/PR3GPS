%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Administradora
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    U->>FE: Accede al panel de administración
    FE->>BE: POST /api/auth/login (email, password)
    BE->>DB: findUsuarioByEmail(email)
    DB-->>BE: Usuario (passwordHash, rol)
    BE->>BE: Usuario.iniciarSesion(email, password)
    alt Rol ADMIN
        BE-->>FE: 200 OK (tokenSesion)
        FE->>BE: GET /api/admin/pedidos
        BE->>DB: Administradora.listarPedidosPagados()
        DB-->>BE: List~Pedido~
        BE-->>FE: 200 OK (List~Pedido~)
        FE-->>U: Muestra tabla con datos de entrega y estado
        opt Marca un pedido como enviado
            U->>FE: Pulsa Marcar como enviado
            FE->>BE: PATCH /api/admin/pedidos/idPedido (estado ENVIADO)
            BE->>BE: Administradora.marcarPedidoEnviado(idPedido)
            BE->>DB: Pedido.cambiarEstado(ENVIADO)
            DB-->>BE: OK
            BE-->>FE: 200 OK (Pedido actualizado)
            FE-->>U: Refresca la tabla con el nuevo estado
        end
    else Sin permisos
        BE-->>FE: 403 Forbidden
        FE-->>U: Deniega el acceso al panel
    end
