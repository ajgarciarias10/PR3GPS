%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    autonumber
    actor U as Cliente
    participant FE as Frontend
    participant BE as Backend
    participant DB as Base de datos
    U->>FE: aplicarCodigo(codigo)
    FE->>BE: aplicarCupon(codigo) : PUT /api/carrito/cupon
    BE->>DB: findCuponByCodigo(codigo)
    DB-->>BE: Cupon o null
    BE->>BE: Cupon.esValido()
    alt Cupón válido y vigente
        BE->>BE: Carrito.aplicarCupon(codigo)
        BE->>BE: Cupon.calcularDescuento(subtotal)
        BE->>BE: Carrito.calcularTotal()
        BE->>DB: saveCarrito(carrito)
        DB-->>BE: OK
        BE-->>FE: 200 OK : Carrito con descuento
        FE-->>U: actualizarTotal(carrito)
    else Inexistente o caducado
        BE-->>FE: 422 Unprocessable Entity
        FE-->>U: mostrarErrorCupon()
    end
